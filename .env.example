# Server Port
PORT=5000

# MongoDB Atlas Connection URI
# Example: mongodb+srv://admin:yourPassword@cluster0.abcde.mongodb.net/doctor_tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/doctor_tracker?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=doctor_tracker_jwt_super_secret_key_2026_xyz_!@#
JWT_EXPIRES_IN=7d

# Allowed Frontend URL for CORS
CLIENT_URL=http://localhost:3000
